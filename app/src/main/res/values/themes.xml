<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Cyan/Gold Dark Theme -->
    <style name="Base.Theme.SaluMate" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorSurface">@color/background_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowFullscreen">true</item>

        <!-- Global text visibility -->
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>

        <!-- TextInputLayout global style: dark box background -->
        <item name="textInputStyle">@style/SaluMate.TextInputLayout</item>
    </style>

    <style name="Theme.SaluMate" parent="Base.Theme.SaluMate" />

    <!-- Global TextInputLayout: dark background, primary stroke, white text -->
    <style name="SaluMate.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/background_card</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary_light</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="editTextColor">@color/text_primary</item>
    </style>

    <!-- Dark Card base -->
    <style name="LuxuryCard" parent="">
        <item name="android:background">@color/background_card</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
</resources>